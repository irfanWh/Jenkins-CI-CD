pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
    }

    environment {
        REGISTRY = 'irfan0456/tp4'
    }

    stages {

        stage('Cloning Git') {
            steps {
                checkout scm
            }
        }

        stage('Building image') {
            steps {
                sh '''
                    echo "=== BUILDING DOCKER IMAGE ==="

                    docker build \
                        -t ${REGISTRY}:${BUILD_NUMBER} .
                '''
            }
        }

        stage('Test image') {
            steps {
                sh '''
                    set -eu

                    echo "=== TESTING IMAGE ==="

                    TEST_CONTAINER="tp4-test-${BUILD_NUMBER}"

                    trap 'docker rm -f "$TEST_CONTAINER" >/dev/null 2>&1 || true' EXIT

                    docker run -d \
                        --name "$TEST_CONTAINER" \
                        "${REGISTRY}:${BUILD_NUMBER}"

                    sleep 2

                    docker exec "$TEST_CONTAINER" \
                        wget -qO- http://127.0.0.1 \
                        | grep -q "Welcome BDCC"

                    echo "Tests passed"
                '''
            }
        }

        stage('Publish Image') {
            steps {
                script {
                    echo "=== PUBLISHING TO DOCKER HUB ==="

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'dockerhub'
                    ) {
                        docker.image(
                            "${env.REGISTRY}:${env.BUILD_NUMBER}"
                        ).push()
                    }
                }
            }
        }

        stage('Deploy image') {
            steps {
                sh '''
                    set -eu

                    echo "=== DEPLOYING APPLICATION ==="

                    docker rm -f tp4-deploy 2>/dev/null || true

                    docker run -d \
                        --name tp4-deploy \
                        --restart unless-stopped \
                        -p 8082:80 \
                        ${REGISTRY}:${BUILD_NUMBER}

                    echo "=== VERIFY DEPLOYMENT ==="

                    docker ps --filter name=tp4-deploy

                    docker exec tp4-deploy \
                        wget -qO- http://127.0.0.1 \
                        | grep -q "Welcome BDCC"

                    echo "Deployment successful"
                '''
            }
        }
    }
}
