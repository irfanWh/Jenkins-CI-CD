pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        REGISTRY = 'irfan0456/tp4'
    }

    stages {

        stage('Cloning Git') {
            steps {
                checkout scm
            }
        }

        stage('Building image') {
            steps {
                sh '''
                    docker build -t ${REGISTRY}:${BUILD_NUMBER} .
                '''
            }
        }

        stage('Test image') {
            steps {
                sh '''
                    set -eu

                    TEST_CONTAINER="tp4-test-${BUILD_NUMBER}"

                    trap 'docker rm -f "$TEST_CONTAINER" >/dev/null 2>&1 || true' EXIT

                    docker run -d \
                        --name "$TEST_CONTAINER" \
                        "${REGISTRY}:${BUILD_NUMBER}"

                    sleep 2

                    docker exec "$TEST_CONTAINER" \
                        wget -qO- http://127.0.0.1 \
                        | grep -q "Welcome BDCC"

                    echo "Tests passed"
                '''
            }
        }

        stage('Publish Image') {
            steps {
                script {
                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'dockerhub'
                    ) {
                        docker.image(
                            "${REGISTRY}:${env.BUILD_NUMBER}"
                        ).push()
                    }
                }
            }
        }
    }
}
